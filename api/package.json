{
  "name": "duesoon-api",
  "version": "1.0.0",
  "private": true,
  "description": "DueSoon API: shared class deadline board (Express 5 + Prisma 7 + Neon Postgres)",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch src/dev.js",
    "test": "node --test \"test/*.test.js\"",
    "test:api": "node --test --test-concurrency=1 \"test-api/*.api.js\"",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:check": "node scripts/check-db.js"
  },
  "overrides": {
    "effect": "^3.22.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "prisma": "^7.10.1"
  }
}
