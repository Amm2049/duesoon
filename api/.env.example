# Copy to .env and fill in. Never share .env or put it in the submitted zip.
# Neon console → your project → Connect. Copy ONLY the URL (not the "psql '...'" command around it).

# POOLED: "Connection pooling" ON, hostname contains "-pooler". Used by the app (src/db.js).
# Use sslmode=verify-full (strict certificate check; avoids the pg driver's SSL warning).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# DIRECT: "Connection pooling" OFF, no "-pooler". Used by the Prisma CLI (db push, seed).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret for signing login tokens (Step 2). At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
